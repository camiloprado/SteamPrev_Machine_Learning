# ============================================
# EXEMPLO DE CONFIGURAÇÃO PARA O PC 2
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo como ".env" no PC 2
# 2. Ajuste PC_ID=2 (este é o PC 2)
# 3. Mantenha TOTAL_PCS=2 (total de PCs trabalhando)
# 4. Mantenha as mesmas configurações de banco de dados do PC 1
#
# IMPORTANTE: Ambos os PCs devem apontar para o MESMO Supabase
# para que os dados sejam centralizados!
# ============================================

# ============================================
# CONFIGURAÇÕES DE BANCO DE DADOS (PostgreSQL)
# ============================================
# DOCKER LOCAL: Para dados RAW (brutos) - Grande volume em JSONB
# Tabelas: steam_raw, itad_raw
# Uso: PostgreSQL.inserir_dadosSteamRaw() via psycopg2

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=projetotccADMIN
DB_HOST=localhost
DB_PORT=5432

POSTGRES_PASSWORD=projetotccADMIN
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================
# CONFIGURAÇÕES DA API REST DO SUPABASE CLOUD
# ============================================
# ⚠️ ATENÇÃO: Use as MESMAS credenciais do PC 1
# para que ambos os PCs gravem no mesmo banco cloud

SUPABASE_URL=https://norphjcxnsgklyutnmin.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5vcnBoamN4bnNna2x5dXRubWluIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjE5NzE5MDEsImV4cCI6MjA3NzU0NzkwMX0.Dw_5TEddbhKCdEBZWMvySoPQB0aCmAPkTLt_oR6vqWA

USE_SUPABASE=true

# ============================================
# CONFIGURAÇÕES DE PROCESSAMENTO
# ============================================

# ⚠️ CONFIGURAÇÃO MULTI-PC - PC 2
PC_ID=2          # Este é o PC 2
TOTAL_PCS=2      # Total de 2 PCs trabalhando em paralelo

RANGE_PROCESSAMENTO_APPIDS_RAW=1000
RANGE_PROCESSAMENTO_APPIDS_BD=3000
RANGE_PROCESSAMENTO_ITAD_RAW=5000

# ============================================
# CONFIGURAÇÕES DA STEAM API
# ============================================

# Configurações para detalhes dos jogos
STEAM_BATCH_SIZE_DETAILS=100 
STEAM_DELAY_BETWEEN_BATCHES_DETAILS=120 
STEAM_ASYNC_CONCURRENCY_DETAILS=1 

# Configurações para avaliações dos jogos
STEAM_BATCH_SIZE_REVIEWS=1000
STEAM_DELAY_BETWEEN_BATCHES_REVIEWS=30 
STEAM_ASYNC_CONCURRENCY_REVIEWS=10 

# Configurações para preços dos jogos
STEAM_BATCH_SIZE_ITAD=1000 
STEAM_DELAY_BETWEEN_BATCHES_ITAD=30 
STEAM_ASYNC_CONCURRENCY_ITAD=300 

TAMANHO_LOTE_CARGA_MAIS=20

# ============================================
# CONFIGURAÇÕES DE LOGGING
# ============================================

LOG_LEVEL=INFO
LOG_LEVEL_SUPABASE=WARNING

# ============================================
# CONFIGURAÇÕES DE TESTES
# ============================================
AMBIENTE=PRD
BATCH_TESTE=20
